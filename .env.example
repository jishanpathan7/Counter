# Copy to .env. Everything is optional.

PORT=3001
# Where the platform database and one database per institute are stored.
DATA_DIR=data
INSTITUTE_TZ=Asia/Kolkata
# How often the scheduler checks for classes to verify, unanswered alerts and daily summaries.
TICK_SECONDS=10

# true (default): a fresh install starts with a demo agency, three institutes and a month of
# history, and the login screen shows the demo accounts (PIN 1234).
# false: a fresh install opens the setup wizard instead. Use this for real deployments.
SEED_DEMO=true

# Secret for signing login cookies. If unset, a random one is generated and kept in the database.
SESSION_SECRET=

# WhatsApp is configured per institute in the app (Settings → WhatsApp & message).
# These older variables are still read once and copied into the first institute.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
