# Copy to .env. Everything is optional.

PORT=3001
# Where the platform database and one database per institute are stored.
DATA_DIR=data
INSTITUTE_TZ=Asia/Kolkata
# How often the scheduler checks for classes to verify, unanswered alerts and daily summaries.
TICK_SECONDS=10

# Demo data: a demo agency, three institutes, a month of history, and demo accounts (PIN 482915)
# shown on the login screen. On by default only with `npm run dev`; elsewhere set SEED_DEMO=true.
# Never use it for a real deployment.
SEED_DEMO=

# Required outside `npm run dev`: at least 32 random characters (openssl rand -hex 32).
# Signs login cookies; changing it signs everyone out.
SESSION_SECRET=

# Optional: key for the WhatsApp credentials stored encrypted in the database (64 random characters,
# openssl rand -hex 32). Without it, a key is derived from SESSION_SECRET. Keep it with your backups'
# details: restoring a backup with a different key means entering the WhatsApp tokens again.
DATA_ENCRYPTION_KEY=

# Which proxies to trust for the visitor's address (used by the login limits). Default "loopback"
# (a reverse proxy on the same machine). Use e.g. 1 for one hop such as a load balancer; serverless
# deploys trust the platform's proxy automatically.
TRUST_PROXY=

# One-time code for the first-run setup wizard. If unset, a random code is printed to the log at
# startup (on serverless hosts you must set it).
SETUP_TOKEN=

# Meta Graph API version for WhatsApp calls (v21.0 is removed on 2027-01-21).
WHATSAPP_GRAPH_VERSION=v26.0

# WhatsApp is configured per institute in the app (Settings → WhatsApp & message).
# These older variables are still read once and copied into the first institute.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Error reports (optional): a Sentry project DSN. Phone numbers are masked; no request data is sent.
SENTRY_DSN=

# Backups (production, see deploy/README.md): Litestream copies every change to this bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_PATH=attendance-alert
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION=720h
BACKUP_HEARTBEAT_URL=
