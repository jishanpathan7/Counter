# Copy to .env and fill in. Everything is optional: with nothing set, the app runs with
# demo data and the built-in WhatsApp simulator.

PORT=3001
INSTITUTE_TZ=Asia/Kolkata
DB_FILE=data/attendance.db
# How often the scheduler checks for sessions to verify and replies that timed out.
TICK_SECONDS=10
# Set to false to start with no demo batches/students.
SEED_DEMO=true

# Shared code teachers and staff type in once per device. Set this before you put the
# app on the internet: it holds students' names and parents' phone numbers.
ACCESS_CODE=

# --- Real WhatsApp (Meta WhatsApp Cloud API). Leave blank to use the simulator. ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template for the absence alert (see README). Without it, alerts are sent as
# interactive messages, which only reach parents who messaged you in the last 24 hours.
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
# Any string you choose; enter the same one in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta (App settings → Basic). Used to check webhook signatures.
WHATSAPP_APP_SECRET=
