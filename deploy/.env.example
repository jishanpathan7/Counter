# Copy to deploy/.env and fill in. Never commit the filled-in file.

# The address people open, e.g. app.yourinstitute.in. Point its DNS A record at this server first.
DOMAIN=

# Required: 64 random characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Optional: key for the WhatsApp credentials stored encrypted in the database (64 random characters,
# openssl rand -hex 32). Without it, a key is derived from SESSION_SECRET. Keep it with your backups'
# details: restoring a backup with a different key means entering the WhatsApp tokens again.
DATA_ENCRYPTION_KEY=
# One-time code for the first-run setup screen (any phrase; only needed once).
SETUP_TOKEN=

INSTITUTE_TZ=Asia/Kolkata

# Backups (strongly recommended): an S3-compatible bucket, ideally in India (e.g. AWS ap-south-1).
BACKUP_S3_BUCKET=
BACKUP_S3_PATH=attendance-alert
BACKUP_S3_REGION=ap-south-1
# Only for non-AWS storage (Cloudflare R2, DigitalOcean Spaces, ...): its S3 endpoint URL.
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# How far back you can restore. 720h = 30 days.
BACKUP_RETENTION=720h
# Optional: a monitor URL (e.g. healthchecks.io) pinged every 5 minutes while backups work.
BACKUP_HEARTBEAT_URL=

# Optional: Sentry project DSN, so you hear about errors before customers call.
SENTRY_DSN=

# Optional: Meta Graph API version for WhatsApp.
WHATSAPP_GRAPH_VERSION=v26.0
