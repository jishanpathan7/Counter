{
  "name": "attendance-alert",
  "version": "1.0.0",
  "private": true,
  "description": "Attendance automation for coaching institutes: teacher marks attendance, absentees' parents get a WhatsApp alert, replies update the register, and no-replies become staff call tasks.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,cyan \"node --watch --no-warnings=ExperimentalWarning server/index.js\" \"vite\"",
    "build": "vite build",
    "start": "node --no-warnings=ExperimentalWarning server/index.js",
    "test": "node --test --no-warnings=ExperimentalWarning test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7"
  }
}
